# Citrinitas 知识库引擎
# ============

# Python 虚拟环境
venv/

# 本地数据（图片、索引、报告、死信）
local_data/
qdrant_data/
snapshots/
storage/

# Qdrant 本地安装目录（由 run.bat 自动下载）
qdrant/

# 运行时锁文件
data/.watch_v2.lock
data/.watch_v2_migrated
data/.watch.lock
data/.watch_migrated

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# 日志
*.log

# 临时文件
tmp.*.json
katex_in_*.json
katex_out_*.json

# OCR 临时文件
*_ocr_tmp.txt

# Qdrant 哨兵文件
NUL

# 守望文件夹运行时状态
data/file_state.jsonl

# BM25 词典（运行时生成，随摄入增长；已从 Git 追踪中移除，仅留本地）
sparse_vocab.json
sparse_vocab.json.tmp

# 守望文件夹（v2）— 摄入文件不提交，仅保留 .gitkeep
data/inbox/*
!data/inbox/.gitkeep

# 知识库大文件夹 library/ — 源文件/图片/状态不提交，仅保留目录结构占位
library/
!library/.gitkeep

# WorkBuddy 内部目录
.workbuddy/

# 清理残留：不属于项目源码的临时/工具/快捷方式文件
.codebuddy/
.streamlit/
ARTIFACTS/
.qdrant-initialized
qdrant.zip
*.lnk

_staging/
